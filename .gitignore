# Local runtime config (copy from config.example.yaml). Anchored to the repo
# root so it does NOT also ignore packaging templates named config.yaml
# (e.g. packaging/windows/portable-template/config.yaml, needed by the CI build).
/config.yaml

# Docker compose secrets (copy from .env.example)
.env

# Local docker volumes (postgres data, etc.)
data/

# Go
/backend/bin/
/backend/tmp/
/backend/backups/
*.test
*.out

# Local SQLite dev database (database.driver: sqlite) + its WAL/SHM sidecars.
# The file is the developer's local data; never commit it.
/backend/justmart.db
/backend/justmart.db-shm
/backend/justmart.db-wal
# Same file when the binary is run from the REPO ROOT rather than backend/
# (database.path is CWD-relative, so `./justmart.db` lands wherever it started).
/justmart.db
/justmart.db-shm
/justmart.db-wal

# Node / frontend
node_modules/
.vite/
# tsc -b incremental cache — a build artifact; tracking it can mask type errors.
*.tsbuildinfo
# Build outputs: frontend bundle + the compiled single binary.
/frontend/dist/
/dist/

# Embedded SPA: the build copies frontend/dist here before `go build`; keep the
# committed stub so //go:embed compiles, ignore everything the build drops in.
/backend/internal/web/dist/*
!/backend/internal/web/dist/.gitkeep

# Playwright
frontend/tests/e2e/.auth/
frontend/test-results/
frontend/playwright-report/

# Playwright MCP browser-tool scratch output (snapshots, console logs, upload staging)
.playwright-mcp/

# Windows installer build artifacts (assembled payload + cached downloads)
packaging/windows/payload/
packaging/windows/.cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.exe

thirdparties/bin
server.exe
graphify-out/

backend/justmart-demo.db

backend/justmart-demo.db-shm

backend/justmart-demo.db-wal

# Throwaway SQLite file created by the e2e suite
backend/e2e/justmart.db
backend/e2e/justmart.db-shm
backend/e2e/justmart.db-wal

# Release video: the throwaway demo instance it records against, and the
# capture/encode outputs. The recorder and its seed are versioned; the 20-30 MB
# media they produce is a build output — see release/README.md.
/.release-demo/
/release/video/
