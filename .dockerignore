# Keep the build context small + reproducible. The Dockerfile builds the SPA
# and the Go binary from source inside the image, so host build artifacts must
# not leak in.
.git
.gitignore
*.md
data/
backups/
dist/
node_modules
frontend/node_modules
frontend/dist
frontend/.vite
frontend/test-results
frontend/playwright-report
frontend/tests/e2e/.auth
backend/bin
backend/tmp
# Host build artifacts + local runtime state under backend/. These never reach
# the final image (only /out/justmart is copied), but they bloat every context
# upload and bust the build cache — server.exe alone is ~41 MB.
backend/*.exe
backend/justmart.db
backend/justmart.db-shm
backend/justmart.db-wal
backend/backups/
backend/connector-identity.json
# The embedded SPA is rebuilt in-image; never copy a host build of it in.
backend/internal/web/dist/assets
# Local runtime config (secrets) — provided via env / compose, never baked in.
config.yaml
